{% extends 'src/App.html.twig' %}

{% block title %}Déclaration de panne{% endblock %}

{% block body %}
  {# Formulaire affiché après scan du QR code ou saisie du code poste. #}
  <div class="report-page">
    <div class="report-card">
      <div class="mobile-topbar">
        <button class="back-icon-btn" type="button" onclick="window.location.href='/'" aria-label="Retour">
          <i data-lucide="chevron-left" width="24" height="24"></i>
        </button>
        <h1>Déclaration de panne</h1>
      </div>

      {% if pc_error %}
        <p class="error-text">{{ pc_error }}</p>
      {% endif %}

      <div class="confirmation-card" id="waitingValidation" {% if not waiting_email %}hidden{% endif %}>
        {# Message affiché quand une validation email/appareil est nécessaire. #}
        <div class="mail-icon">📧</div>
        <h2>Email envoyé !</h2>
        <p class="confirmation-text">Un email de validation a été envoyé à :</p>
        <div class="success-box">
          <strong id="waitingEmail">{{ waiting_email }}</strong>
        </div>
        <p class="confirmation-text">Veuillez valider votre email pour finaliser votre demande.</p>
        <p class="delay-text">Lien valable 30 minutes.</p>
      </div>

      {% if pc %}
        <div class="pc-info-card" id="pcInfo" {% if waiting_email %}hidden{% endif %}>
          <p>Poste détecté</p>
          <div><strong>Salle</strong> : {{ pc.salle }}</div>
          <div><strong>Poste</strong> : {{ pc.poste }}</div>
        </div>

        {% if error %}
          <p class="error-text" id="errorText">{{ error }}</p>
        {% endif %}

        <form id="ticketForm" {% if waiting_email %}hidden{% endif %}>
          {# L'email est séparé en identifiant + domaine pour limiter les erreurs. #}
          <label>Type d'utilisateur</label>
          <div class="user-type-box">
            <label>
              <input type="radio" name="user_type" value="etudiant" checked>
              Étudiant
            </label>
            <label>
              <input type="radio" name="user_type" value="Professeur">
              Professeur
            </label>
          </div>

          <label>Adresse email universitaire <span>*</span></label>
          <div class="email-box">
            <input type="text" name="email_prefix" id="emailPrefix" placeholder="prenom.nom" required>
            <span id="emailDomain">@alumni.univ-avignon.fr</span>
          </div>
          <p class="field-help">Seuls les emails universitaires sont acceptés.</p>

          <label>Type de panne <span>*</span></label>
          <select name="type_panne" id="typePanne" required>
            <option value="">Sélectionnez le type de panne</option>
            {% for panne in pannes %}
              <option value="{{ panne }}">{{ panne }}</option>
            {% endfor %}
          </select>

          <div id="customPanneBox" hidden>
            <label>Définir la panne <span>*</span></label>
            <input type="text" name="custom_panne" id="customPanne" placeholder="Exemple : Problème de casque">
          </div>

          <label>Description (optionnelle)</label>
          <textarea name="description" id="description" maxlength="500" placeholder="Décrivez le problème rencontré..."></textarea>
          <p class="char-count"><span id="descriptionCount">0</span>/500</p>

          <button type="submit" class="primary-btn" id="submitButton" disabled>Continuer</button>
        </form>
      {% endif %}
    </div>

    <div class="app-dialog" id="appDialog" hidden>
      <div class="app-dialog-card">
        <div class="app-dialog-icon">
          <i data-lucide="triangle-alert" width="34" height="34"></i>
        </div>
        <h2>Attention</h2>
        <p id="dialogMessage"></p>
        <button type="button" id="dialogButton">OK</button>
      </div>
    </div>
  </div>
{% endblock %}

{% block scripts %}
  <script>
    // Données du poste envoyées par Symfony vers la page Twig.
    const pc = {{ pc ? pc|json_encode|raw : 'null' }};
    const emailPrefix = document.getElementById("emailPrefix");
    const typePanne = document.getElementById("typePanne");
    const customPanne = document.getElementById("customPanne");
    const customPanneBox = document.getElementById("customPanneBox");
    const submitButton = document.getElementById("submitButton");
    const emailDomain = document.getElementById("emailDomain");
    const userTypeInputs = document.querySelectorAll('input[name="user_type"]');
    const ticketForm = document.getElementById("ticketForm");
    const description = document.getElementById("description");
    const descriptionCount = document.getElementById("descriptionCount");
    const waitingValidation = document.getElementById("waitingValidation");
    const waitingEmail = document.getElementById("waitingEmail");
    const pcInfo = document.getElementById("pcInfo");
    const appDialog = document.getElementById("appDialog");
    const dialogMessage = document.getElementById("dialogMessage");
    const dialogButton = document.getElementById("dialogButton");

    if (localStorage.getItem("theme") === "dark") {
      document.body.classList.add("dark-mode");
    }

    function showMessage(message) {
      dialogMessage.textContent = message;
      appDialog.hidden = false;
      if (window.lucide) window.lucide.createIcons();
    }

    function selectedUserType() {
      return document.querySelector('input[name="user_type"]:checked')?.value || "etudiant";
    }

    function updateDomain() {
      if (!emailDomain) return;
      emailDomain.textContent = selectedUserType() === "Professeur" ? "@univ-avignon.fr" : "@alumni.univ-avignon.fr";
      localStorage.setItem("userType", selectedUserType());
    }

    function updateForm() {
      if (!submitButton) return;

      const needsCustom = typePanne.value === "Autre";
      customPanneBox.hidden = !needsCustom;
      customPanne.required = needsCustom;
      submitButton.disabled = !emailPrefix.value.trim() || !typePanne.value || (needsCustom && !customPanne.value.trim());
      descriptionCount.textContent = String(description.value.length);
    }

    function buildEmail() {
      emailPrefix.value = emailPrefix.value.trim().toLowerCase();
      return (
        emailPrefix.value +
        (selectedUserType() === "etudiant"
          ? "@alumni.univ-avignon.fr"
          : "@univ-avignon.fr")
      ).toLowerCase();
    }

    function getIdentityFromEmail(email) {
      const username = email.split("@")[0];
      const parts = username.split(".");

      return {
        prenom: parts[0] || "",
        nom: parts.slice(1).join(" ") || "",
      };
    }

    function buildTicket() {
      const email = buildEmail();
      const identity = getIdentityFromEmail(email);

      return {
        nom: identity.nom,
        prenom: identity.prenom,
        pc_id: pc.id,
        email,
        type_panne: typePanne.value,
        custom_panne: customPanne.value,
        description: description.value,
      };
    }

    function getDeviceId() {
      // Identifiant local de l'appareil pour ne pas valider le mail à chaque fois.
      let deviceId = localStorage.getItem("ticketPanneDeviceId");

      if (!deviceId) {
        if (window.crypto && window.crypto.randomUUID) {
          deviceId = window.crypto.randomUUID();
        } else {
          deviceId = `${Date.now()}-${Math.random().toString(16).slice(2)}`;
        }

        localStorage.setItem("ticketPanneDeviceId", deviceId);
      }

      return deviceId;
    }

    if (emailPrefix) {
      emailPrefix.value = localStorage.getItem("emailPrefix") || "";
      emailPrefix.addEventListener("input", () => {
        emailPrefix.value = emailPrefix.value.toLowerCase();
        localStorage.setItem("emailPrefix", emailPrefix.value);
        updateForm();
      });
    }

    const savedUserType = localStorage.getItem("userType");
    if (savedUserType) {
      const savedInput = document.querySelector(`input[name="user_type"][value="${savedUserType}"]`);
      if (savedInput) savedInput.checked = true;
    }

    userTypeInputs.forEach((input) => input.addEventListener("change", () => {
      updateDomain();
      updateForm();
    }));

    [typePanne, customPanne, description].forEach((field) => {
      field?.addEventListener("input", updateForm);
      field?.addEventListener("change", updateForm);
    });

    ticketForm?.addEventListener("submit", async (event) => {
      // Envoi direct du signalement au backend Symfony puis redirection vers ALADIN.
      event.preventDefault();

      const email = buildEmail();
      const emailRegex = /^[a-zA-Z0-9._%+-]+@(univ-avignon\.fr|alumni\.univ-avignon\.fr)$/;

      if (!emailRegex.test(email)) {
        showMessage("Veuillez utiliser une adresse email universitaire.");
        return;
      }

      localStorage.setItem("emailPrefix", emailPrefix.value.toLowerCase());
      localStorage.setItem("userType", selectedUserType());

      const response = await fetch("/api/tickets", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-Device-Id": getDeviceId(),
        },
        body: JSON.stringify(buildTicket()),
      });

      const data = await response.json().catch(() => ({ message: "Une erreur est survenue." }));

      if (response.status === 202) {
        waitingEmail.textContent = email;
        waitingValidation.hidden = false;
        ticketForm.hidden = true;
        if (pcInfo) pcInfo.hidden = true;
        return;
      }

      if (data.redirectUrl) {
        window.location.href = data.redirectUrl;
        return;
      }

      showMessage(data.message || "Une erreur est survenue.");
    });

    dialogButton?.addEventListener("click", () => {
      appDialog.hidden = true;
    });

    updateDomain();
    updateForm();
  </script>
{% endblock %}
