{
  "type": "project",
  "require": {
    "php": ">=8.2",
    "symfony/dotenv": "^7.0",
    "symfony/flex": "^2",
    "symfony/framework-bundle": "^7.0",
    "symfony/mailer": "^7.0",
    "symfony/runtime": "^7.0",
    "symfony/twig-bundle": "^7.0",
    "twig/twig": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  }
}
